; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

[application]

config/name="Fallout Forecast Car"
config/description="Car client for Fallout Forecast Cloud Play (talks to the car bridge)."
run/main_scene="res://main.tscn"
boot_splash/image="res://icon.png"
boot_splash/fullsize=false
boot_splash/bg_color=Color( 0.047, 0.078, 0.133, 1 )
config/icon="res://icon.png"
config/project_settings_override="user://override.cfg"

[audio]

mix_rate=48000
output_latency=50

[autoload]

Settings="*res://core/settings.gd"
Assets="*res://core/assets.gd"
UI="*res://ui/style.gd"
RetroMat="*res://world/retro_materials.gd"
Sound="*res://core/sound.gd"
Net="*res://core/net.gd"

[debug]

settings/fps/force_fps=60
gdscript/warnings/unused_argument=false
gdscript/warnings/narrowing_conversion=false
gdscript/warnings/unused_signal=false
gdscript/warnings/integer_division=false

[display]

window/size/width=1240
window/size/height=606
window/size/test_width=1240
window/size/test_height=606
window/handheld/orientation="sensor_landscape"
window/stretch/mode="2d"
window/stretch/aspect="expand"

[gui]

common/drop_mouse_on_gui_input_disabled=true

[importer_defaults]

ogg_vorbis={
"loop": false,
"loop_offset": 0
}

scene={
"animation/import": false,
"materials/keep_on_reimport": true,
"materials/location": 1,
"materials/storage": 0,
"meshes/compress": false,
"meshes/ensure_tangents": false,
"meshes/light_baking": 0,
"meshes/octahedral_compression": false,
"meshes/storage": 0,
"nodes/root_type": "Spatial",
"skins/use_named_skins": true
}

[input_devices]

pointing/emulate_touch_from_mouse=true

[network]

limits/websocket_client/max_in_buffer_kb=512
limits/websocket_client/max_in_packets=2048
limits/websocket_client/max_out_buffer_kb=128
ssl/certificate_bundle_override=""

[physics]

common/enable_pause_aware_picking=true

[rendering]

batching/parameters/colored_vertex_format_threshold=0.0

quality/driver/driver_name="GLES2"
quality/driver/fallback_to_gles2=true
quality/intended_usage/framebuffer_allocation=0
quality/intended_usage/framebuffer_allocation.mobile=0
vram_compression/import_etc=true
vram_compression/import_etc2=false
quality/directional_shadow/size=1024
quality/directional_shadow/size.mobile=512
quality/shadow_atlas/size=0
quality/shadow_atlas/size.mobile=0
quality/shadows/filter_mode=0
quality/reflections/texture_array_reflections=false
quality/reflections/high_quality_ggx=false
quality/shading/force_vertex_shading=true
quality/shading/force_lambert_over_burley=true
quality/shading/force_blinn_over_ggx=true
quality/filters/use_nearest_mipmap_filter=true
gles2/compatibility/disable_half_float=true
limits/buffers/canvas_polygon_buffer_size_kb=256
limits/buffers/canvas_polygon_index_buffer_size_kb=256
environment/default_clear_color=Color( 0.047, 0.078, 0.133, 1 )
quality/depth/hdr=false
gles2/compatibility/disable_half_float.mobile=true
